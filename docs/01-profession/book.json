{
  "title": "测试开发工程师体系化知识库",
  "author": "Test Development Engineer",
  "description": "测试开发工程师体系化学习路径与知识图谱",
  "language": "zh-hans",
  "gitbook": "3.2.x",
  "structure": {
    "readme": "README.md",
    "summary": "SUMMARY.md"
  },
  "plugins": [
    "splitter",
    "expandable-chapters-small",
    "anchors",
    "github",
    "sharing",
    "search",
    "lunr"
  ],
  "pluginsConfig": {
