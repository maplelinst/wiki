      "url": "https://github.com/tlin/KnowledgeBase"
    },
    "sharing": {
      "facebook": false,
      "twitter": true,
      "google": false,
      "weibo": true,
      "instapaper": false,
      "vk": false,
      "all": ["weibo", "twitter", "google"]
    }
  }
}
